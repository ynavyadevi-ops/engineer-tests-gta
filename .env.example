# Engineer Tests GTA — settings reference. PLACEHOLDERS ONLY. Never put a real key in this file.
#
# Where real values go (the app does NOT read a repo-level .env, because this repo is
# inside a OneDrive-synced folder and anything here would be uploaded):
#   1. Process environment variables, or
#   2. The private env file:  %LOCALAPPDATA%\EngineerTestsGTA\private.env
#      (override its location with GTA_LAB_ENV_FILE). Copy only the lines you need.
#
# Only the backend and CLI read these. Never create VITE_* variables for secrets:
# the frontend build refuses secret-looking VITE_* names.

# demo = fixture data only, never touches the network (default). live = real API data.
GTA_LAB_MODE=demo

# Data folder. Default: %LOCALAPPDATA%\EngineerTestsGTA\data (local, not synced).
# Demo and live databases live in separate subfolders. Paths with spaces are fine.
# GTA_LAB_DATA_DIR=D:\GTA lab data

# Loopback only (127.0.0.1, ::1, localhost). Anything else is rejected.
GTA_LAB_HOST=127.0.0.1
GTA_LAB_PORT=8765

# Optional: serve the UI from a different build folder (default: frontend\dist).
# GTA_LAB_FRONTEND_DIST=

# YouTube Data API v3 key (Phase 03+). Personal Google Cloud project, restricted to
# YouTube Data API v3. Put the real value only in the private env file or process env.
YOUTUBE_API_KEY=your-youtube-data-api-v3-key-here
